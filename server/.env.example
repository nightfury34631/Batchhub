# =========================================================================
# BatchHub Server Environment Configuration Template
# =========================================================================
# Copy this file to .env and configure with secure values.
# NEVER commit .env to version control.
# If credentials have been previously committed or exposed, ROTATE THEM IMMEDIATELY.

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port
PORT=5000

# Database Configuration (MariaDB / MySQL)
DB_HOST=localhost
DB_USER=root
# In production, DB_PASSWORD must be non-empty and securely generated
DB_PASSWORD=
DB_NAME=batchhub_db

# JWT Secret Key
# In development: minimum 16 characters.
# In production: MUST be a strong, unpredictable random string of at least 32 characters.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Production CORS Allowlist (comma-separated origins)
# Example: https://batchhub.university.edu,https://app.batchhub.edu
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
